# Copy to .env and fill in. .env is git-ignored.

# Arm D judge (TypeSafe). Pin the version; never use jev-latest in a benchmark run.
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0

# Optional alternate Jev providers for the Space's bring-your-own-key tab.
# OPENROUTER_API_KEY=            # Decisions endpoint, model typesafe/jev-1.13, path /api/alpha/decisions
# AI_GATEWAY_API_KEY=            # Vercel AI Gateway, model typesafe-ai/jev

# Local judges (arms C-*). Any server speaking /v1/systemone works here.
LOCAL_JUDGE_BASE_URL=http://127.0.0.1:8100
LOCAL_JUDGE_MODEL=laya-english

# Writer: llama-server or Unsloth Desktop, OpenAI-compatible.
LLAMA_SERVER_URL=http://127.0.0.1:8081/v1
GENERATOR_MODEL=gemma-4-E2B-it-qat-UD-Q4_K_XL
GENERATOR_SEED=20260919

# Search.
SEARXNG_URL=http://127.0.0.1:8080

# Memory.
MEMPALACE_PALACE_PATH=./palace
MEMPALACE_BACKEND=chroma

# Frontier grader. Must be a model that plays no role in the pipeline (spec rule 9).
GRADER_BASE_URL=http://100.105.44.30:4000/v1
GRADER_API_KEY=
GRADER_MODEL=claude-sonnet-5
